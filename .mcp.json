{
  "mcpServers": {
    "playwright": {
      "command": "env",
      "args": [
        "-u",
        "http_proxy",
        "-u",
        "https_proxy",
        "-u",
        "HTTP_PROXY",
        "-u",
        "HTTPS_PROXY",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--headless"
      ]
    }
  }
}
