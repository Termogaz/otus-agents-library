{
  "mcpServers": {
    "playwright": {
      "command": "env",
      "args": [
        "-u",
        "http_proxy",
        "-u",
        "https_proxy",
        "-u",
        "HTTP_PROXY",
        "-u",
        "HTTPS_PROXY",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--headless"
      ]
    },
    "postgres": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp:0.3.0",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "${LIBRARY_MCP_DATABASE_URI}"
      }
    }
  }
}
