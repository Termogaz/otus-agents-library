# Зависимости (восстанавливаются: npm ci)
node_modules/

# Сборка
dist/
*.tsbuildinfo

# Тесты: отчёты и артефакты
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
# Snapshot'ы и логи консоли Playwright MCP
.playwright-mcp/

# Данные запуска (коммитим только data/seed.json)
data/*.json
!data/seed.json
# Временные файлы атомарной записи, если процесс упал до rename
data/*.tmp

# Секреты
.env
.env.*
!.env.example

# Личные настройки агента
.claude/settings.local.json
CLAUDE.local.md

# GSD Core: файлы локальной установки (восстанавливаются:
# npx @opengsd/gsd-core@1.18.0 --claude --local; hooks GSD — в settings.local.json)
.claude/.gsd-profile
.claude/gsd-*
.claude/agents/gsd-*
.claude/commands/gsd-*
.claude/hooks/gsd-*
.claude/hooks/lib/*.js
.claude/hooks/lib/gsd-*
.claude/hooks/managed-hooks-registry.cjs
.claude/hooks/package.json
.claude/scripts/

# Личные заметки и выгрузки бесед (не публикуем)
.local/

# Логи, ОС, IDE
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
